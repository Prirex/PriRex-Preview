{
  "name": "dsh-prirex-preview",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "PriRex Preview: живой предпросмотр в DeepSeek Harness — автопоиск статического сайта или Node.js-проекта, локальный сервер и dev-сервер за прокси, WebSocket live-reload, панель устройств, перехват ошибок консоли и точечный DOM-инспектор с CSS-метаданными.",
  "license": "MIT",
  "author": {
    "name": "Prirex",
    "url": "https://github.com/Prirex"
  },
  "homepage": "https://github.com/Prirex/PriRex-Preview#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prirex/PriRex-Preview.git"
  },
  "bugs": {
    "url": "https://github.com/Prirex/PriRex-Preview/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "live-reload",
    "websocket",
    "nodejs",
    "dev-server",
    "dom-inspector",
    "preview",
    "developer-tools"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/",
    "locale/",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/finalize-client.mjs",
    "smoke": "node scripts/smoke-client.mjs lib/client.js",
    "test:hub": "node scripts/test-hub.mjs",
    "check": "npm run build && npm run smoke"
  },
  "dependencies": {
    "ws": "^8.17.0",
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
